# Copy this file to .env and fill in real values — never commit .env itself

# From your hosting provider's Postgres addon (Railway, Render, Supabase...)
DATABASE_URL=postgres://user:password@host:5432/najran_db

# Any long random string — used to sign login sessions
JWT_SECRET=change-this-to-a-long-random-string

# Server port (most hosts set this automatically — safe to leave as-is)
PORT=4000

# From Meta for Developers → your app → Instagram Graph API
# You need App Review approval before this works for client accounts you don't own.
META_ACCESS_TOKEN=
