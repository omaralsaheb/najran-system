{
  "rules": {
    ".read": false,
    ".write": false,
    "meta": {
      "initialized": {
        ".read": true,
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isBoolean()"
      }
    },
    "roles": {
      ".read": "auth != null",
      ".write": "auth != null && (!data.exists() || root.child('roles').child(root.child('employees').child(auth.uid).child('roleKey').val()).child('permissions').child('settings').val() === true)",
      "$roleKey": {
        ".validate": "newData.hasChild('label')",
        "label": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "permissions": {
          "$perm": {
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "employees": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ((!root.child('employees').exists() && $uid === auth.uid) || root.child('roles').child(root.child('employees').child(auth.uid).child('roleKey').val()).child('permissions').child('team').val() === true)",
        ".validate": "newData.hasChildren(['name', 'username', 'roleKey'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().contains('@')"
        },
        "roleKey": {
          ".validate": "newData.isString() && (root.child('roles').child(newData.val()).exists() || !root.child('roles').exists())"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        },
        "username": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 30 && newData.val().matches(/^[a-z0-9._-]+$/)"
        },
        "isAccessAccount": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "clients": {
      ".read": "auth != null",
      "$clientId": {
        ".write": "auth != null && ((newData.exists() && root.child('roles').child(root.child('employees').child(auth.uid).child('roleKey').val()).child('permissions').child('overview').val() === true) || (data.exists() && !newData.exists() && root.child('employees').child(auth.uid).child('active').val() === true && root.child('employees').child(auth.uid).child('isAccessAccount').val() !== true && root.child('roles').child(root.child('employees').child(auth.uid).child('roleKey').val()).child('permissions').child('settings').val() === true))",
        ".validate": "newData.hasChildren(['name', 'industry'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150"
        },
        "industry": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "content": {
      ".read": "auth != null",
      "$clientId": {
        ".write": "auth != null",
        "$contentId": {
          ".validate": "newData.hasChildren(['type', 'title'])",
          "type": {
            ".validate": "newData.val() === 'reel' || newData.val() === 'post' || newData.val() === 'story'"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 255"
          },
          "views": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "likes": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "comments": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "shares": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "tasks": {
      ".read": "auth != null",
      ".write": "auth != null && (newData.exists() || (data.exists() && !newData.exists() && root.child('employees').child(auth.uid).child('active').val() === true && root.child('employees').child(auth.uid).child('isAccessAccount').val() !== true && root.child('roles').child(root.child('employees').child(auth.uid).child('roleKey').val()).child('permissions').child('settings').val() === true))",
      "$taskId": {
        ".validate": "newData.hasChildren(['title', 'assigneeId'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 255"
        },
        "assigneeId": {
          ".validate": "root.child('employees').child(newData.val()).exists()"
        },
        "priority": {
          ".validate": "newData.val() === 'high' || newData.val() === 'mid' || newData.val() === 'low'"
        },
        "status": {
          ".validate": "newData.val() === 'today' || newData.val() === 'progress' || newData.val() === 'paused' || newData.val() === 'review' || newData.val() === 'revision' || newData.val() === 'done'"
        },
        "deliveryMethod": {
          ".validate": "newData.val() === 'whatsapp' || newData.val() === 'drive'"
        },
        "deliveryLink": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000"
        },
        "completedAt": {
          ".validate": "newData.isNumber()"
        },
        "completedBy": {
          ".validate": "root.child('employees').child(newData.val()).exists()"
        }
      }
    },
    "taskActivity": {
      ".read": "auth != null",
      "$taskId": {
        "$actId": {
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.hasChildren(['action', 'createdAt'])"
        }
      }
    },
    "serviceRequests": {
      ".read": "auth != null",
      "$requestId": {
        ".write": "auth != null && ((!data.exists() && newData.child('employeeId').val() === auth.uid && newData.child('status').val() === 'pending') || (data.exists() && (root.child('roles').child(root.child('employees').child(auth.uid).child('roleKey').val()).child('permissions').child('team').val() === true || root.child('roles').child(root.child('employees').child(auth.uid).child('roleKey').val()).child('permissions').child('settings').val() === true)))",
        ".validate": "newData.hasChildren(['type', 'details', 'status', 'employeeId', 'createdAt'])",
        "type": { ".validate": "newData.val() === 'leave' || newData.val() === 'purchase' || newData.val() === 'maintenance' || newData.val() === 'other'" },
        "details": { ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 2000" },
        "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected'" },
        "employeeId": { ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === auth.uid)" }
      }
    },
    "announcements": {
      ".read": "auth != null && root.child('employees').child(auth.uid).child('active').val() === true && root.child('employees').child(auth.uid).child('isAccessAccount').val() !== true",
      "$announcementId": {
        ".write": "auth != null && (root.child('roles').child(root.child('employees').child(auth.uid).child('roleKey').val()).child('permissions').child('team').val() === true || root.child('roles').child(root.child('employees').child(auth.uid).child('roleKey').val()).child('permissions').child('settings').val() === true)",
        ".validate": "newData.hasChildren(['title', 'body', 'authorId', 'createdAt'])",
        "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 150" },
        "body": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 3000" },
        "authorId": { ".validate": "newData.val() === auth.uid" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "generalChat": {
      "messages": {
        ".read": "auth != null && root.child('employees').child(auth.uid).child('active').val() === true && root.child('employees').child(auth.uid).child('isAccessAccount').val() !== true",
        "$messageId": {
          ".write": "auth != null && !data.exists() && root.child('employees').child(auth.uid).child('active').val() === true && root.child('employees').child(auth.uid).child('isAccessAccount').val() !== true && newData.child('senderId').val() === auth.uid",
          ".validate": "newData.hasChildren(['senderId', 'senderName', 'text', 'createdAt'])",
          "senderId": { ".validate": "newData.val() === auth.uid" },
          "senderName": { ".validate": "newData.isString() && newData.val() === root.child('employees').child(auth.uid).child('name').val()" },
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "privateChats": {
      "$chatId": {
        ".read": "auth != null && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid)) && root.child('employees').child(auth.uid).child('active').val() === true && root.child('employees').child(auth.uid).child('isAccessAccount').val() !== true",
        "messages": {
          "$messageId": {
            ".write": "auth != null && !data.exists() && ($chatId.beginsWith(auth.uid + '_') || $chatId.endsWith('_' + auth.uid)) && root.child('employees').child(auth.uid).child('active').val() === true && root.child('employees').child(auth.uid).child('isAccessAccount').val() !== true && newData.child('senderId').val() === auth.uid",
            ".validate": "newData.hasChildren(['senderId', 'senderName', 'text', 'createdAt'])",
            "senderId": { ".validate": "newData.val() === auth.uid" },
            "senderName": { ".validate": "newData.isString() && newData.val() === root.child('employees').child(auth.uid).child('name').val()" },
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 2000" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "presence": {
      ".read": "auth != null && root.child('employees').child(auth.uid).child('active').val() === true && root.child('employees').child(auth.uid).child('isAccessAccount').val() !== true",
      "$uid": {
        ".write": "auth != null && $uid === auth.uid && root.child('employees').child(auth.uid).child('active').val() === true && root.child('employees').child(auth.uid).child('isAccessAccount').val() !== true",
        ".validate": "newData.hasChildren(['online', 'lastSeen'])",
        "online": { ".validate": "newData.isBoolean()" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },
    "attendance": {
      "$date": {
        "$uid": {
          ".read": "auth != null && ($uid === auth.uid || root.child('roles').child(root.child('employees').child(auth.uid).child('roleKey').val()).child('permissions').child('team').val() === true)",
          ".write": "auth != null && $uid === auth.uid",
          "checkIn": { ".validate": "!data.exists() && newData.isNumber()" },
          "checkOut": { ".validate": "!data.exists() && newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },
    "finance": {
      ".read": "auth != null && root.child('roles').child(root.child('employees').child(auth.uid).child('roleKey').val()).child('permissions').child('finance').val() === true",
      ".write": "auth != null && root.child('roles').child(root.child('employees').child(auth.uid).child('roleKey').val()).child('permissions').child('finance').val() === true",
      "$clientId": {
        "advancePaid": {
          ".validate": "newData.isNumber()"
        },
        "extraExpenses": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "financeActivity": {
      ".read": "auth != null && root.child('roles').child(root.child('employees').child(auth.uid).child('roleKey').val()).child('permissions').child('finance').val() === true",
      "$clientId": {
        "$actId": {
          ".write": "auth != null && !data.exists() && root.child('roles').child(root.child('employees').child(auth.uid).child('roleKey').val()).child('permissions').child('finance').val() === true"
        }
      }
    }
  }
}
